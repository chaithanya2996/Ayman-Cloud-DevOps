# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*
terraform.tfstate
terraform.tfstate.backup

# Crash logs
crash.log
crash.*.log

# Terraform plan files
*.tfplan
*.plan

# Variable files that may contain secrets
*.tfvars
*.tfvars.json

# Exception: allow example variable files
!*.tfvars.example

# Terraform lock file
# KEEP THIS FILE IN GIT
# .terraform.lock.hcl

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc

# Sensitive local files
*.pem
*.key
*.pfx

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

# Temporary files
*.tmp
*.temp
*.swp